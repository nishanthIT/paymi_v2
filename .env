# ============================================
# 🔧 ENVIRONMENT CONFIGURATION
# ============================================
# Switch between LOCAL and PRODUCTION by changing EXPO_PUBLIC_ENV

# Environment: 'LOCAL' or 'PRODUCTION'
EXPO_PUBLIC_ENV=PRODUCTION


# ============================================
# 🌐 PRODUCTION SETTINGS
# ============================================
EXPO_PUBLIC_PRODUCTION_URL=https://backend.h7tex.com

# ============================================
# 🏠 LOCAL DEVELOPMENT SETTINGS  
# ============================================
# Update this to your computer's WiFi IP address
# Find it: ipconfig (Windows) or ifconfig (Mac/Linux)
# Physical devices CANNOT use localhost - they need the actual IP
EXPO_PUBLIC_LOCAL_IP=192.168.1.42
 

EXPO_PUBLIC_LOCAL_PORT=3000

# ============================================
# ⚙️ APP SETTINGS
# ============================================
EXPO_PUBLIC_API_TIMEOUT=10000
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://www.freeprivacypolicy.com/live/cbfe40fb-4b9c-4eb0-bf73-296137cb742d
